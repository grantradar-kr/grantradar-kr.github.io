# Supabase (없으면 자동으로 기기 저장 모드로 동작)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google AdSense
#  - 저장소 기본값: ca-pub-3631676636047500 (소유권 확인 메타태그·ads.txt 에 자동 반영)
#  - 광고 단위(슬롯) ID 는 승인 후 광고 단위를 만들고 넣는다. 비어 있으면 <ins> 슬롯을 렌더하지 않는다.
VITE_ADSENSE_CLIENT=ca-pub-3631676636047500
VITE_ADSENSE_SLOT=

# 카카오 애드핏 (선택) — 단위 ID 를 넣으면 AdSense 대신 애드핏을 사용한다.
VITE_ADFIT_UNIT=
VITE_ADFIT_WIDTH=320
VITE_ADFIT_HEIGHT=100

# 광고 네트워크 선택: auto(기본, AdSense 우선) | adsense | adfit | none
VITE_AD_NETWORK=auto
VITE_SHOW_AD_PLACEHOLDER=false

# 앱 버전
VITE_APP_VERSION=v1.0.0
